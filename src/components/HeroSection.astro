---
// Hero section with CSS entrance animations
---

<section class="hero">
  <div class="hero-content">
    <div class="tag fade-up delay-1">&lt;developer /&gt;</div>
    <h1 class="title">
      <span class="line fade-up delay-2">Explore</span>
      <span class="line accent fade-up delay-3">the Frontier</span>
    </h1>
    <div class="tagline fade-up delay-4">Minimal · Fast · Orderly</div>
    <div class="cta-group fade-up delay-5">
      <a href="https://blog.iocussl.dpdns.org" class="btn-primary">Read Blog</a>
      <a href="https://github.com/null0NULL123" class="btn-ghost">Learn More</a>
    </div>
  </div>
</section>

<style>
  .fade-up {
    opacity: 0;
    animation: fadeUp 0.5s ease-out forwards;
  }

  .delay-1 { animation-delay: 0.2s; }
  .delay-2 { animation-delay: 0.5s; }
  .delay-3 { animation-delay: 0.6s; }
  .delay-4 { animation-delay: 0.7s; }
  .delay-5 { animation-delay: 0.9s; }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1;
    overflow: hidden;
  }

  .hero-content {
    text-align: center;
    padding: 2rem;
    max-width: 800px;
  }

  .tag {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--accent);
    margin-bottom: 1.5rem;
    letter-spacing: 0.1em;
  }

  .title {
    font-size: clamp(2.5rem, 8vw, 5rem);
    font-weight: 300;
    line-height: 1.1;
    margin-bottom: 1.5rem;
  }

  .title .accent {
    color: var(--accent);
    font-weight: 600;
    text-shadow: var(--glow);
  }

  .tagline {
    font-family: var(--font-mono);
    font-size: 1rem;
    color: var(--text-secondary);
    margin-bottom: 2.5rem;
    letter-spacing: 0.3em;
  }

  .cta-group {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn-primary {
    padding: 0.8rem 2rem;
    background: var(--accent);
    color: var(--bg-primary) !important;
    font-weight: 600;
    font-size: 0.9rem;
    letter-spacing: 0.05em;
    border: none;
    cursor: pointer;
    transition: box-shadow 0.2s;
  }

  .btn-primary:hover {
    box-shadow: var(--glow);
    opacity: 1 !important;
  }

  .btn-ghost {
    padding: 0.8rem 2rem;
    background: transparent;
    color: var(--text-primary) !important;
    border: 1px solid var(--border);
    font-size: 0.9rem;
    letter-spacing: 0.05em;
    transition: border-color 0.2s;
  }

  .btn-ghost:hover {
    border-color: var(--accent);
    opacity: 1 !important;
  }

  @media (max-width: 640px) {
    .hero-content {
      padding: 1rem;
    }
  }
</style>
