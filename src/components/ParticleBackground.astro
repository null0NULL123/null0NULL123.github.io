---
// Canvas 2D particle background - zero dependencies
---

<canvas id="particle-canvas"></canvas>

<script>
  const canvas = document.getElementById('particle-canvas') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;

  function resize() {
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
    halfW = canvas.width / 2;
    halfH = canvas.height / 2;
  }

  let halfW: number;
  let halfH: number;
  resize();
  window.addEventListener('resize', resize);

  const isMobile = matchMedia('(max-width: 768px)').matches;
  const PARTICLE_COUNT = isMobile ? 150 : 500;
  const MAX_DIST = 120;
  const MAX_DIST_SQ = MAX_DIST * MAX_DIST;
  const CONNECTION_PARTICLES = isMobile ? 30 : 80;

  const pos = new Float32Array(PARTICLE_COUNT * 2);
  const vel = new Float32Array(PARTICLE_COUNT * 2);
  const screenX = new Float32Array(PARTICLE_COUNT);
  const screenY = new Float32Array(PARTICLE_COUNT);

  for (let i = 0; i < PARTICLE_COUNT * 2; i += 2) {
    pos[i] = (Math.random() - 0.5) * canvas.width;
    pos[i + 1] = (Math.random() - 0.5) * canvas.height;
    vel[i] = (Math.random() - 0.5) * 0.3;
    vel[i + 1] = (Math.random() - 0.5) * 0.3;
  }

  let mouseNormX = 0;
  let mouseNormY = 0;
  let cameraX = 0;
  let cameraY = 0;

  document.addEventListener('mousemove', (e) => {
    mouseNormX = (e.clientX / canvas.width) * 2 - 1;
    mouseNormY = -(e.clientY / canvas.height) * 2 + 1;
  });

  let rotation = 0;
  let rafId = 0;

  function animate() {
    rafId = requestAnimationFrame(animate);

    ctx.clearRect(0, 0, canvas.width, canvas.height);

    cameraX += (mouseNormX * 40 - cameraX) * 0.02;
    cameraY += (mouseNormY * 40 - cameraY) * 0.02;
    rotation += 0.0008;

    const cos = Math.cos(rotation);
    const sin = Math.sin(rotation);
    const bound = Math.max(canvas.width, canvas.height) * 0.6;

    for (let i = 0; i < PARTICLE_COUNT * 2; i += 2) {
      pos[i] += vel[i];
      pos[i + 1] += vel[i + 1];

      if (pos[i] > bound) pos[i] = -bound;
      else if (pos[i] < -bound) pos[i] = bound;
      if (pos[i + 1] > bound) pos[i + 1] = -bound;
      else if (pos[i + 1] < -bound) pos[i + 1] = bound;
    }

    // Precompute screen coordinates once
    for (let i = 0; i < PARTICLE_COUNT; i++) {
      const pi = i * 2;
      screenX[i] = pos[pi] * cos - pos[pi + 1] * sin + cameraX + halfW;
      screenY[i] = pos[pi] * sin + pos[pi + 1] * cos + cameraY + halfH;
    }

    // Draw connections as a single batched path
    ctx.lineWidth = 1;
    ctx.beginPath();
    for (let i = 0; i < CONNECTION_PARTICLES; i++) {
      const xi = screenX[i];
      const yi = screenY[i];

      for (let j = i + 1; j < PARTICLE_COUNT; j++) {
        const dx = xi - screenX[j];
        const dy = yi - screenY[j];
        const distSq = dx * dx + dy * dy;

        if (distSq < MAX_DIST_SQ) {
          ctx.moveTo(xi, yi);
          ctx.lineTo(screenX[j], screenY[j]);
        }
      }
    }
    ctx.strokeStyle = 'rgba(255,255,255,0.06)';
    ctx.stroke();

    // Draw particles as a single batched path
    ctx.fillStyle = 'rgba(255,255,255,0.8)';
    ctx.beginPath();
    for (let i = 0; i < PARTICLE_COUNT; i++) {
      ctx.moveTo(screenX[i] + 2.5, screenY[i]);
      ctx.arc(screenX[i], screenY[i], 2.5, 0, Math.PI * 2);
    }
    ctx.fill();
  }

  // Pause when tab is hidden
  document.addEventListener('visibilitychange', () => {
    if (document.hidden) {
      cancelAnimationFrame(rafId);
    } else {
      animate();
    }
  });

  animate();
</script>

<style>
  #particle-canvas {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
  }
</style>
